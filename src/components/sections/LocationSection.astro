---
import Section from '@/components/layout/Section.astro';
import Container from '@/components/layout/Container.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import StylizedMap from '@/components/sections/StylizedMap.astro';
import LocationNavLinks from '@/components/sections/location/LocationNavLinks.astro';
import { LOCATION, SCHEDULE, CONTACT } from '@/lib/site';
---

<Section id="ubicacion" variant="cream-grain">
  <Container>
    <div class="grid items-end gap-6 md:grid-cols-[1fr_auto] md:gap-12">
      <SectionHeading
        align="left"
        numero="08"
        eyebrow="¿Dónde entrenamos?"
        title="La cancha del barrio."
        subtitle={`${LOCATION.venue} · nuestra sede principal. También entrenamos en la ${LOCATION.secondaryVenue.toLowerCase()}.`}
      />
      <p
        class="text-brand-navy/70 hidden font-serif text-sm italic md:block md:max-w-[18rem] md:text-right"
        style="font-variation-settings: 'opsz' 144, 'wght' 400;"
      >
        «Misma hora, misma cancha. Tres veces a la semana, todo el año.»
      </p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-[2fr_3fr] lg:items-stretch">
      <div
        class="reveal reveal--from-left border-brand-navy/15 relative flex flex-col gap-8 rounded-sm border bg-white p-6 shadow-sm md:p-8 lg:h-full"
        style="--idx:0"
      >
        <!-- Stamp circular giratorio -->
        <div
          class="stamp-spin border-brand-navy-deep bg-brand-gold absolute -top-3 -right-3 flex h-16 w-16 items-center justify-center rounded-full border-2 shadow-md"
        >
          <span
            class="section-marker text-brand-navy-deep px-1 text-center text-[0.6rem] leading-tight italic"
          >
            cancha<br /><span class="font-display text-base not-italic"
              >oficial</span
            >
          </span>
        </div>
        <div class="flex flex-col gap-6">
          <div class="flex gap-4">
            <div
              class="pin-drop bg-brand-navy/10 text-brand-navy mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl"
            >
              <svg
                aria-hidden="true"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-neutral-700">
                Cancha principal
              </p>
              <p class="text-base text-neutral-600">{LOCATION.venue}</p>
              <p class="text-sm text-neutral-500">
                {LOCATION.city}, {LOCATION.region}
              </p>
              <p class="mt-1 text-sm text-neutral-500">
                También entrenamos en la {LOCATION.secondaryVenue.toLowerCase()} (<a
                  href={LOCATION.secondaryMapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-brand-navy underline underline-offset-2"
                  >ver en el mapa</a
                >)
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div
              class="bg-brand-navy/10 text-brand-navy mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl"
            >
              <svg
                aria-hidden="true"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-neutral-700">Horarios</p>
              {
                SCHEDULE.bloques.map((bloque) => (
                  <p class="text-base text-neutral-600">
                    {bloque.dias} — {bloque.horas}
                  </p>
                ))
              }
            </div>
          </div>

          <div class="flex gap-4">
            <div
              class="bg-brand-navy/10 text-brand-navy mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl"
            >
              <svg
                aria-hidden="true"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-neutral-700">Contacto</p>
              <a
                href={`tel:${CONTACT.phoneE164}`}
                class="text-brand-navy focus-visible:outline-brand-gold text-base hover:underline focus-visible:outline-2"
              >
                {CONTACT.phoneDisplay}
              </a>
              <p class="mt-0.5 text-xs text-neutral-500">WhatsApp disponible</p>
            </div>
          </div>
        </div>

        <LocationNavLinks />
      </div>

      <div class="reveal reveal--from-right" style="--idx:1">
        <StylizedMap />
      </div>
    </div>
  </Container>
</Section>
