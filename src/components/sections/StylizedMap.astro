---
import StylizedMapSvg from '@/components/sections/location/StylizedMapSvg.astro';
import { LOCATION } from '@/lib/site';
---

<div
  class="stylized-map-container ring-brand-navy/10 relative aspect-[4/3] overflow-hidden rounded-2xl shadow-xl ring-1 sm:aspect-[5/4] lg:aspect-auto lg:h-full lg:min-h-[460px]"
>
  <StylizedMapSvg />

  <!-- Etiqueta glassmorphic de la cancha -->
  <div
    class="absolute right-4 bottom-4 left-4 sm:right-6 sm:bottom-6 sm:left-6"
  >
    <div
      class="rounded-2xl border border-white/20 bg-white/10 px-4 py-3 backdrop-blur-md sm:px-5 sm:py-4"
    >
      <div class="flex items-start gap-3">
        <div
          class="bg-brand-gold text-brand-navy-deep mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full"
        >
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
            ></path>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-base leading-tight font-bold text-white sm:text-lg">
            {LOCATION.venue}
          </p>
          <p class="text-xs text-white/70 sm:text-sm">
            {LOCATION.neighborhood} · {LOCATION.city}, {LOCATION.region}
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
