---
import { HISTORIA } from '@/lib/historia';

const [primerParrafo, ...restParrafos] = HISTORIA.parrafos;

// Nombre del tributo en dos líneas: nombre de pila / apellidos.
const palabrasNombre = HISTORIA.tributo.nombre.split(' ');
const tributoNombreHtml = `${palabrasNombre.slice(0, 2).join(' ')}<br />${palabrasNombre.slice(2).join(' ')}`;
---

<section
  id="historia"
  class="bg-brand-navy-deep bg-pitch-lines text-brand-cream relative overflow-hidden py-16 md:py-24"
>
  <span
    class="text-brand-gold/10 pointer-events-none absolute top-6 -left-6 font-serif text-[16rem] leading-none select-none md:text-[22rem]"
    aria-hidden="true"
    style="font-variation-settings:'opsz' 144,'wght' 700;">«</span
  >

  <div class="relative mx-auto max-w-7xl px-4 md:px-6 lg:px-8">
    <!-- Encabezado -->
    <div class="mx-auto max-w-3xl text-center">
      <div
        class="reveal flex items-center justify-center gap-3 pb-4"
        style="--idx:0"
      >
        <span class="section-marker text-brand-gold text-base italic"
          >Nº 04</span
        >
        <span class="bg-brand-gold/40 inline-block h-px w-10" aria-hidden="true"
        ></span>
        <p
          class="text-brand-gold text-[0.7rem] font-bold tracking-[0.22em] uppercase"
        >
          {HISTORIA.eyebrow}
        </p>
      </div>
      <h2
        class="reveal font-display text-display leading-[0.95] text-white"
        style="--idx:1"
      >
        {HISTORIA.titulo}
      </h2>
      <p
        class="reveal text-brand-cream/80 mx-auto mt-4 max-w-2xl font-serif text-lg leading-snug italic md:text-xl"
        style="--idx:2; font-variation-settings:'opsz' 144,'SOFT' 40,'wght' 400;"
      >
        {HISTORIA.subtitulo}
      </p>
    </div>

    <!-- Narrativa + Tributo -->
    <div
      class="mt-12 grid gap-10 lg:grid-cols-[1fr_minmax(280px,360px)] lg:gap-14"
    >
      <div
        class="reveal reveal--read text-brand-cream/85 space-y-5 text-[0.975rem] leading-relaxed md:text-base"
        style="--idx:0"
      >
        <p>
          <span
            class="font-display text-brand-gold float-left mt-1 mr-3 text-6xl leading-[0.7]"
            >D</span
          >
          {primerParrafo.slice(1)}
        </p>
        {
          restParrafos.map((p) =>
            p.includes('Club Deportivo Chuter F.C.') ? (
              <p
                set:html={p.replace(
                  'Club Deportivo Chuter F.C.',
                  '<strong class="font-semibold text-white">Club Deportivo Chuter F.C.</strong>',
                )}
              />
            ) : (
              <p>{p}</p>
            ),
          )
        }
      </div>

      <!-- Tarjeta tributo -->
      <aside
        class="reveal reveal--from-right reveal--read lg:pt-2"
        style="--idx:1"
      >
        <figure
          class="border-brand-gold/30 bg-brand-cream text-brand-navy-deep sticky top-24 rounded-sm border p-6 shadow-2xl shadow-black/40 md:p-7"
        >
          <div class="flex items-center gap-4">
            <div
              class="bg-brand-navy-deep bg-pitch-lines text-brand-gold ring-brand-navy-deep/30 relative flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-sm shadow-md ring-1"
            >
              <span class="font-display text-3xl leading-none tracking-wide"
                >{HISTORIA.tributo.iniciales}</span
              >
            </div>
            <div>
              <p
                class="text-brand-clay text-[0.65rem] font-bold tracking-[0.22em] uppercase"
              >
                En memoria
              </p>
              <p
                class="font-display text-brand-navy-deep text-2xl leading-[0.95]"
                set:html={tributoNombreHtml}
              />
              <p class="section-marker text-brand-clay text-base italic">
                {HISTORIA.tributo.apodo}
              </p>
            </div>
          </div>
          <dl
            class="border-brand-navy/25 mt-5 space-y-3 border-t border-dashed pt-4 text-sm"
          >
            <div class="flex items-baseline justify-between gap-3">
              <dt
                class="text-brand-navy/75 text-[0.65rem] font-bold tracking-wider uppercase"
              >
                Posición
              </dt>
              <dd class="text-brand-navy-deep font-semibold">Arquero</dd>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <dt
                class="text-brand-navy/75 text-[0.65rem] font-bold tracking-wider uppercase"
              >
                Servicio
              </dt>
              <dd class="text-brand-navy-deep text-right font-semibold">
                Suboficial · Armada Nacional
              </dd>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <dt
                class="text-brand-navy/75 text-[0.65rem] font-bold tracking-wider uppercase"
              >
                Legado
              </dt>
              <dd class="text-brand-navy-deep text-right font-semibold">
                Club Deportivo Chuter F.C.
              </dd>
            </div>
          </dl>
          <p
            class="text-brand-navy-deep/75 mt-4 font-serif text-sm leading-snug italic"
            style="font-variation-settings:'opsz' 144,'wght' 400;"
          >
            El club que hoy lleva su nombre es el cumplimiento del sueño que
            imaginó junto a su hermano.
          </p>
        </figure>
      </aside>
    </div>

    <!-- Cita memorial -->
    <figure
      class="reveal reveal--read border-brand-gold/30 mx-auto mt-14 max-w-4xl border-t pt-10 text-center"
      style="--idx:0"
    >
      <p
        class="text-brand-cream font-serif text-2xl leading-snug italic md:text-3xl"
        style="font-variation-settings:'opsz' 144,'SOFT' 50,'wght' 400;"
      >
        «En memoria de Jesús David Andrade Guerra <span class="text-brand-gold"
          >"Chuter"</span
        >, cuyo amor por el fútbol seguirá viviendo en cada niño que persiga sus
        sueños dentro y fuera de la cancha.»
      </p>
      <figcaption
        class="text-brand-cream/60 mt-6 flex items-center justify-center gap-3 text-[0.7rem] tracking-[0.25em] uppercase"
      >
        <span class="bg-brand-gold/50 h-px w-8" aria-hidden="true"></span>
        {HISTORIA.citaAutor}
        <span class="bg-brand-gold/50 h-px w-8" aria-hidden="true"></span>
      </figcaption>
    </figure>
  </div>
</section>
