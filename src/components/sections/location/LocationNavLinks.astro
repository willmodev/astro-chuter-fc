---
import { LOCATION } from '@/lib/site';

const mapsQuery = encodeURIComponent(
  `${LOCATION.venue}, ${LOCATION.city}, ${LOCATION.region}`,
);
// Link corto que envió el club: apunta a la cancha exacta, no a una búsqueda.
const googleMapsUrl = LOCATION.mapsUrl;
const wazeUrl = `https://www.waze.com/ul?q=${mapsQuery}&navigate=yes`;
---

<div
  class="border-brand-navy/10 mt-auto grid grid-cols-1 gap-3 border-t pt-6 sm:grid-cols-2"
>
  <a
    href={googleMapsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="border-brand-navy/15 text-brand-navy hover:border-brand-navy/30 focus-visible:outline-brand-gold inline-flex items-center justify-center gap-2 rounded-xl border bg-white px-4 py-3 text-sm font-semibold shadow-sm transition-all hover:bg-neutral-50 focus-visible:outline-2 focus-visible:outline-offset-2"
  >
    <svg
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
      ></path>
    </svg>
    <span>Abrir en Google Maps</span>
  </a>
  <a
    href={wazeUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="border-brand-navy/15 text-brand-navy hover:border-brand-navy/30 focus-visible:outline-brand-gold inline-flex items-center justify-center gap-2 rounded-xl border bg-white px-4 py-3 text-sm font-semibold shadow-sm transition-all hover:bg-neutral-50 focus-visible:outline-2 focus-visible:outline-offset-2"
  >
    <svg
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
      ></path>
    </svg>
    <span>Abrir en Waze</span>
  </a>
</div>
