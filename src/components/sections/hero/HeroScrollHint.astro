---
/**
 * HeroScrollHint — línea vertical + chevron pulsante.
 * Reemplaza animate-bounce con un easing más sofisticado.
 */
---

<span class="text-brand-gold inline-flex items-center gap-2">
  <span>Bajá para descubrir</span>
  <span
    class="relative inline-flex h-7 w-3 items-center justify-center"
    aria-hidden="true"
  >
    <span
      class="bg-brand-gold/50 absolute inset-x-1/2 top-0 h-3 w-px -translate-x-1/2"
    ></span>
    <span
      class="hero-scroll-chevron absolute bottom-0 inline-block leading-none"
      >↓</span
    >
  </span>
</span>
