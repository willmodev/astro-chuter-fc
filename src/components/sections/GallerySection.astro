---
import { getImage } from 'astro:assets';

import Section from '@/components/layout/Section.astro';
import Container from '@/components/layout/Container.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import GalleryLightbox from '@/components/interactive/GalleryLightbox';
import { SALAS_GALERIA } from '@/lib/galeria';
import type { FotoGaleria } from '@/lib/galeria';
import type { SalaRenderizada } from '@/components/interactive/gallery/types';

// Ancho que la pieza llega a ocupar en la retícula de 4 columnas. Se pide sin
// recortar: el encuadre lo hace `object-cover`, así se evita el doble recorte.
function anchoThumb({ gridClass }: FotoGaleria): number {
  return gridClass.includes('col-span-2') ? 900 : 480;
}

async function renderizarFoto(foto: FotoGaleria) {
  const [thumb, full] = await Promise.all([
    getImage({
      src: foto.src,
      width: anchoThumb(foto),
      format: 'webp',
      quality: 78,
    }),
    getImage({ src: foto.src, width: 1080, format: 'webp', quality: 85 }),
  ]);

  return {
    src: full.src,
    thumbnail: thumb.src,
    alt: foto.alt,
    cedula: foto.cedula,
    width: full.attributes.width as number,
    height: full.attributes.height as number,
    gridClass: foto.gridClass,
  };
}

let offset = 0;
const salas: SalaRenderizada[] = [];

for (const sala of SALAS_GALERIA) {
  const piezas = await Promise.all(sala.fotos.map(renderizarFoto));
  salas.push({
    numero: sala.numero,
    titulo: sala.titulo,
    descripcion: sala.descripcion,
    piezas,
    offset,
  });
  offset += piezas.length;
}

const totalPiezas = offset;
---

<Section id="galeria" variant="white">
  <Container>
    <div class="grid items-end gap-6 md:grid-cols-[1fr_auto] md:gap-12">
      <SectionHeading
        align="left"
        numero="06"
        eyebrow="Fotos del club"
        title="En acción, con el barrio."
        subtitle="Un recorrido en tres salas por lo que pasa cada lunes, miércoles y viernes en la cancha."
      />
      <p
        class="text-brand-navy/70 hidden font-serif text-sm italic md:block md:max-w-[18rem] md:text-right"
        style="font-variation-settings: 'opsz' 144, 'wght' 400;"
      >
        «Cada foto es una jugada, una sonrisa, una historia que se está
        escribiendo en la cancha.»
      </p>
    </div>

    <p
      class="text-brand-navy/45 mt-8 font-mono text-[0.7rem] tracking-[0.2em] uppercase"
    >
      {SALAS_GALERIA.length} salas · {totalPiezas} piezas
    </p>

    <div class="mt-8">
      <GalleryLightbox salas={salas} client:visible />
    </div>
  </Container>
</Section>
