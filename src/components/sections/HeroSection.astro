---
import { Image } from 'astro:assets';

import heroImg from '@/assets/images/club/hero-evento.jpg';
import BrandButton from '@/components/layout/BrandButton.astro';
import HeroTicket from '@/components/sections/hero/HeroTicket';
import HeroBallBg from '@/components/sections/hero/HeroBallBg.astro';
import HeroEyebrow from '@/components/sections/hero/HeroEyebrow.astro';
import HeroScrollHint from '@/components/sections/hero/HeroScrollHint.astro';
import HeroHeadline from '@/components/sections/hero/HeroHeadline';
import HeroParallaxLayer from '@/components/sections/hero/HeroParallaxLayer';
import { WA_HERO } from '@/lib/whatsapp';
import { SCHEDULE, LOCATION } from '@/lib/site';
---

<section
  id="inicio"
  class="bg-brand-navy-deep relative isolate flex min-h-[88vh] items-center overflow-hidden"
  aria-label="Sección principal de Chuter FC"
>
  <!-- Capa 1 (más lenta): imagen hero, da sensación de fondo profundo.
       La foto va bajo un overlay navy al 85-95%, así que en mobile pedimos
       menos resolución que el ancho real: baja el peso del LCP sin verse. -->
  <HeroParallaxLayer speed={0.55} client:idle className="absolute inset-0 z-0">
    <!-- La fuente mide 1280px de ancho (foto de WhatsApp): no se piden anchos
         mayores para no hacer upscale. El vignette de la derecha cubre el resto. -->
    <Image
      src={heroImg}
      alt="Niños y niñas de Chuter FC reunidos en la cancha junto a sus formadores"
      class="h-[120%] w-full object-cover object-[50%_60%] 2xl:[filter:saturate(1.08)]"
      widths={[540, 800, 1080, 1280]}
      sizes="(max-width: 767px) 75vw, 100vw"
      loading="eager"
      fetchpriority="high"
      quality={62}
    />
  </HeroParallaxLayer>

  <!-- Overlay base navy (estático) -->
  <div
    class="from-brand-navy-deep/95 via-brand-navy-deep/85 to-brand-navy/55 absolute inset-0 z-[1] bg-gradient-to-r"
  >
  </div>
  <!-- Vignette lateral derecho para enmascarar pixelación en pantallas wide sin oscurecer la foto al medio -->
  <div
    class="from-brand-navy-deep/50 pointer-events-none absolute inset-y-0 right-0 z-[1] hidden w-[40%] bg-gradient-to-l to-transparent xl:block"
  >
  </div>

  <!-- Capa 2 (semi-fast): bloom dorado + pelota SVG, primer plano decorativo -->
  <HeroParallaxLayer
    speed={1.25}
    client:idle
    className="pointer-events-none absolute inset-0 z-[2]"
  >
    <div
      class="bg-brand-gold/15 pointer-events-none absolute -top-24 -left-24 h-[480px] w-[480px] rounded-full blur-3xl"
    >
    </div>
    <HeroBallBg />
  </HeroParallaxLayer>

  <!-- Grain overlay -->
  <div
    class="bg-grain pointer-events-none absolute inset-0 z-[3] opacity-60 mix-blend-overlay"
  >
  </div>

  <!-- Cinta diagonal vertical lateral derecha (decorativa) -->
  <div
    class="pointer-events-none absolute top-0 right-0 z-[3] hidden h-full w-16 lg:block xl:w-20"
  >
    <div
      class="diagonal-stripes text-brand-gold/[0.04] h-full w-full"
      style="mask-image: linear-gradient(to right, transparent 0%, black 60%);"
    >
    </div>
  </div>

  <div
    class="relative z-10 mx-auto grid w-full max-w-7xl gap-10 px-4 py-20 md:px-6 lg:grid-cols-[1.5fr_1fr] lg:gap-16 lg:px-12 lg:py-24"
  >
    <!-- Columna principal -->
    <div class="space-y-8">
      <HeroEyebrow />

      <!-- Headline cinematográfico (island con char-by-char + scroll-linked y/opacity) -->
      <HeroHeadline client:load />

      <!-- Sub copy y horario -->
      <div class="reveal-line max-w-xl space-y-2" style="--idx:6">
        <p class="text-base leading-relaxed text-white/80 md:text-lg">
          Escuela de fútbol formativo para niños y niñas en Los Algarrobillos.
          Avalada por <span class="font-semibold text-white">INDER</span>.
        </p>
        <p
          class="text-brand-gold text-sm font-semibold tracking-wider uppercase"
        >
          {SCHEDULE.daysHuman} — {SCHEDULE.hoursHuman}
        </p>
      </div>

      <!-- CTAs -->
      <div
        class="reveal-line flex flex-col gap-3 sm:flex-row sm:items-center"
        style="--idx:7"
      >
        <BrandButton
          href={WA_HERO}
          variant="cta-gold"
          size="lg"
          target="_blank"
          ariaLabel="¡Quiero inscribirme gratis! — escribir a Chuter FC por WhatsApp"
        >
          ¡Quiero inscribirme gratis!
        </BrandButton>
        <a
          href="#programas"
          class="group hover:text-brand-gold focus-visible:outline-brand-gold inline-flex items-center gap-2 px-2 py-3 text-sm font-semibold tracking-wider text-white uppercase transition-colors focus-visible:outline-2 focus-visible:outline-offset-4"
        >
          Ver programas
          <span
            aria-hidden="true"
            class="inline-block transition-transform group-hover:translate-x-1"
            >→</span
          >
        </a>
      </div>
    </div>

    <!-- Columna lateral: ticket card como island con spring + breathing -->
    <HeroTicket client:idle />
  </div>

  <!-- Strip inferior con "scroll" hint -->
  <div
    class="bg-brand-navy-deep/60 absolute right-0 bottom-0 left-0 z-10 border-t border-white/10 backdrop-blur-sm"
  >
    <div
      class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 text-[0.65rem] tracking-[0.25em] text-white/60 uppercase md:px-6 lg:px-12"
    >
      <span class="hidden sm:inline"
        >{LOCATION.venue} · {LOCATION.secondaryVenueShort}</span
      >
      <HeroScrollHint />
      <span
        class="section-marker hidden tracking-normal text-white/70 normal-case italic sm:inline"
        >desde 2024</span
      >
    </div>
  </div>
</section>
