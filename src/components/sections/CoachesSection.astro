---
import { getCollection } from 'astro:content';

import { listarProgramas } from '@/lib/programas';

const formadores = (await getCollection('formadores')).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const directivos = formadores.filter((f) => f.data.etiqueta === 'Dirección');
const entrenadores = formadores.filter((f) => f.data.etiqueta === 'Entrenador');

// Edad por categoría, desde el catálogo único (spec 15): nunca un rango de años
// escrito a mano. La clave es el nombre de la categoría, que es el `rol` del
// formador en su markdown.
const edadesPorCategoria = new Map(
  (await listarProgramas()).map((p) => [p.nombre, p.edades]),
);

function initials(nombre: string): string {
  return nombre
    .trim()
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();
}
---

<section id="equipo" class="bg-brand-cream bg-grain relative py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 md:px-6 lg:px-8">
    <!-- Encabezado -->
    <div class="mx-auto max-w-3xl text-center">
      <div
        class="reveal flex items-center justify-center gap-3 pb-4"
        style="--idx:0"
      >
        <span class="section-marker text-brand-navy text-base italic"
          >Nº 05</span
        >
        <span class="bg-brand-navy/15 inline-block h-px w-10" aria-hidden="true"
        ></span>
        <p
          class="text-brand-gold-deep text-[0.7rem] font-bold tracking-[0.22em] uppercase"
        >
          El equipo detrás del club
        </p>
      </div>
      <h2
        class="reveal font-display text-display text-brand-navy-deep leading-[0.95]"
        style="--idx:1"
      >
        Quienes hacen posible el club.
      </h2>
      <p
        class="reveal mx-auto mt-4 max-w-2xl text-base leading-relaxed text-neutral-600 md:text-lg"
        style="--idx:2"
      >
        Directivos, profesionales y formadores comprometidos con cada niño y
        niña que pasa por la cancha.
      </p>
    </div>

    <!-- Dirección -->
    <div class="mt-12">
      <div class="reveal flex items-center gap-3 pb-1" style="--idx:0">
        <span class="section-marker text-brand-clay text-base italic"
          >Dirección</span
        >
        <span
          class="bg-brand-navy/15 inline-block h-px flex-1"
          aria-hidden="true"></span>
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {
          directivos.map((d, i) => (
            <article
              class="coach-flip border-brand-navy/10 relative flex items-center gap-5 rounded-sm border bg-white p-6 shadow-sm md:gap-6 md:p-7"
              data-from={i % 2 === 0 ? 'left' : 'right'}
              style={`--idx:${i}`}
            >
              <div class="bg-brand-navy-deep bg-pitch-lines text-brand-gold ring-brand-navy/20 relative flex h-24 w-24 shrink-0 items-center justify-center overflow-hidden rounded-sm shadow-md ring-1 md:h-28 md:w-28">
                <span class="font-display text-4xl leading-none tracking-wide md:text-5xl">
                  {initials(d.data.nombre)}
                </span>
                <span
                  class="bg-brand-gold/70 absolute top-2 right-2 h-1.5 w-1.5 rounded-full"
                  aria-hidden="true"
                />
              </div>
              <div class="min-w-0">
                <span class="bg-brand-navy text-brand-cream inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[0.6rem] font-bold tracking-wider uppercase">
                  {d.data.etiqueta}
                </span>
                <h3 class="font-display text-brand-navy-deep mt-2 text-[2rem] leading-[0.9]">
                  {d.data.nombre}
                </h3>
                <p
                  class="text-brand-clay font-serif text-base italic"
                  style="font-variation-settings:'opsz' 144,'wght' 500;"
                >
                  {d.data.rol}
                </p>
                {d.data.bio && (
                  <p class="text-brand-navy-deep/70 mt-2 text-sm leading-relaxed">
                    {d.data.bio}
                  </p>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Cuerpo técnico -->
    <div class="mt-12">
      <div class="reveal flex items-center gap-3 pb-1" style="--idx:0">
        <span class="section-marker text-brand-clay text-base italic"
          >Cuerpo técnico</span
        >
        <span
          class="bg-brand-navy/15 inline-block h-px flex-1"
          aria-hidden="true"></span>
      </div>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          entrenadores.map((e, i) => (
            <article
              class="coach-flip border-brand-navy/10 relative flex flex-col items-center gap-4 rounded-sm border bg-white p-6 text-center shadow-sm"
              data-from={i % 2 === 0 ? 'left' : 'right'}
              style={`--idx:${i}`}
            >
              <span
                class="font-display text-brand-navy-deep/[0.05] pointer-events-none absolute right-3 -bottom-3 text-[5rem] leading-none select-none"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="bg-brand-navy-deep bg-pitch-lines text-brand-gold ring-brand-navy/20 flex h-24 w-24 items-center justify-center overflow-hidden rounded-full shadow-md ring-1">
                <span class="font-display text-4xl leading-none tracking-wide">
                  {initials(e.data.nombre)}
                </span>
              </div>
              <div>
                <h3 class="font-display text-brand-navy-deep text-2xl leading-tight">
                  {e.data.nombre}
                </h3>
                <p class="text-brand-gold-deep text-[0.7rem] font-bold tracking-wider uppercase">
                  Entrenador
                </p>
              </div>
              <div class="border-brand-navy/20 mt-auto w-full border-t border-dashed pt-3">
                <p
                  class="text-brand-clay font-serif text-base italic"
                  style="font-variation-settings:'opsz' 144,'wght' 500;"
                >
                  Categoría {e.data.rol}
                </p>
                {edadesPorCategoria.get(e.data.rol) && (
                  <p class="text-brand-navy/45 mt-1 text-[0.7rem] tracking-wider uppercase">
                    {edadesPorCategoria.get(e.data.rol)}
                  </p>
                )}
                {e.data.bio && (
                  <p class="text-brand-navy/45 mt-1 text-[0.7rem] tracking-wider uppercase">
                    {e.data.bio}
                  </p>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
